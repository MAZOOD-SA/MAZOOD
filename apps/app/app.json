{
  "expo": {
    "name": "مزوّد",
    "slug": "mazood",
    "scheme": "mazood",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.mazood.app"
    },
    "android": {
      "package": "sa.mazood.app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "lang": "ar"
    },
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "85b5ac03-84e9-4cc2-b2ab-ec88d567cae4"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
