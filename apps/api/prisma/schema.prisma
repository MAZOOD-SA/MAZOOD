// شكل قاعدة البيانات. الشرح المبسّط في PLAN.md (القسم ٣) وdocs/architecture.md.
// أي تغيير هنا يحتاج «ترحيل» (migration): pnpm --filter @mazood/api db:migrate
//
// قواعد ثابتة:
//   - المبالغ بالهللة كأرقام صحيحة (Int)، ولا مرة كسور.
//   - رموز التحقق وجلسات الدخول ما تنحفظ كما هي، ينحفظ «بصمتها» (hash) بس.
//   - سجل الإجراءات (audit_log) إضافة فقط: قاعدة البيانات نفسها تمنع تعديله أو حذفه.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  factory
  provider
  staff
}

enum UserStatus {
  active
  suspended
}

enum RequestStatus {
  awaiting_offers
  accepted
  in_progress
  completed
  cancelled
}

enum CancelRequestStatus {
  pending
  declined
}

enum OfferStatus {
  pending
  accepted
  declined
}

enum When {
  today
  tomorrow
  this_week
}

// ─── الحسابات والدخول ───────────────────────────────────────────

/// كل شخص يدخل المنصة. الدخول برقم الجوال فقط (ما فيه كلمات مرور).
model User {
  id        String     @id @default(uuid()) @db.Uuid
  /// بصيغة دولية: +9665XXXXXXXX
  phone     String     @unique
  role      UserRole   @default(factory)
  status    UserStatus @default(active)
  locale    String     @default("ar")
  createdAt DateTime   @default(now()) @map("created_at")

  sessions         Session[]
  factoryMembers   FactoryMember[]
  createdRequests  Request[]       @relation("RequestCreatedBy")

  @@map("users")
}

/// رموز التحقق المرسلة. ينحفظ hash الرمز بس، مع عدد المحاولات ووقت الانتهاء.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenges")
}

/// جلسات الدخول. التطبيق يحمل رمز الجلسة، والخادم يحفظ hash الرمز بس،
/// فلو تسرّبت قاعدة البيانات ما ينفع أحد يدخل بالرموز.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── المصانع ───────────────────────────────────────────

model Factory {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  location           String
  /// اختياري الحين، ويصير إلزامي قبل الفاتورة (المرحلة ٥).
  commercialRegister String?  @map("commercial_register")
  vatNumber          String?  @map("vat_number")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  members  FactoryMember[]
  requests Request[]

  @@map("factories")
}

/// مين من المستخدمين تابع لأي مصنع. الجدول يسمح بأكثر من موظف للمصنع
/// (سؤال ١١، مؤجّل)، لكن الواجهة الحين تعرض موظف واحد.
model FactoryMember {
  factoryId String   @map("factory_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("owner")
  createdAt DateTime @default(now()) @map("created_at")

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([factoryId, userId])
  @@index([userId])
  @@map("factory_members")
}

// ─── المزوّدين (نسخة مبسّطة، تكتمل في المرحلة ٣) ───────────────

model Provider {
  id              String   @id @default(uuid()) @db.Uuid
  nameAr          String   @map("name_ar")
  nameEn          String   @map("name_en")
  verified        Boolean  @default(false)
  /// التقييم من ٥ بالعُشر: ٤٨ = ٤٫٨
  ratingTenths    Int      @default(0) @map("rating_tenths")
  completedOrders Int      @default(0) @map("completed_orders")
  /// مزوّد وهمي للتجربة. ما يُستخدم أبدًا في بيئة الإنتاج.
  isDemo          Boolean  @default(false) @map("is_demo")
  createdAt       DateTime @default(now()) @map("created_at")

  offers Offer[]

  @@map("providers")
}

// ─── الطلبات والعروض ───────────────────────────────────────────

model Request {
  id                  String               @id @default(uuid()) @db.Uuid
  factoryId           String               @map("factory_id") @db.Uuid
  createdById         String               @map("created_by_id") @db.Uuid
  category            String
  typeId              String               @map("type_id")
  details             String
  location            String
  when                When
  status              RequestStatus        @default(awaiting_offers)
  cancelRequestStatus CancelRequestStatus? @map("cancel_request_status")
  disputeOpenedAt     DateTime?            @map("dispute_opened_at")
  acceptedOfferId     String?              @unique @map("accepted_offer_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  acceptedAt          DateTime?            @map("accepted_at")
  startedAt           DateTime?            @map("started_at")
  completedAt         DateTime?            @map("completed_at")
  cancelledAt         DateTime?            @map("cancelled_at")

  factory       Factory @relation(fields: [factoryId], references: [id])
  createdBy     User    @relation("RequestCreatedBy", fields: [createdById], references: [id])
  offers        Offer[] @relation("RequestOffers")
  acceptedOffer Offer?  @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id])

  @@index([factoryId, createdAt])
  @@map("requests")
}

model Offer {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @map("request_id") @db.Uuid
  providerId   String      @map("provider_id") @db.Uuid
  /// السعر قبل الضريبة بالهللة
  priceHalalas Int         @map("price_halalas")
  summaryAr    String      @map("summary_ar")
  summaryEn    String      @map("summary_en")
  noteAr       String      @default("") @map("note_ar")
  noteEn       String      @default("") @map("note_en")
  status       OfferStatus @default(pending)
  seenAt       DateTime?   @map("seen_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  request    Request  @relation("RequestOffers", fields: [requestId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id])
  acceptedBy Request? @relation("AcceptedOffer")

  @@unique([requestId, providerId])
  @@index([requestId])
  @@map("offers")
}

// ─── الإعدادات والسجل ───────────────────────────────────────────

/// إعدادات المنصة اللي تتغيّر بدون مبرمج (مثل سياسة الإلغاء، ونسبة العمولة لاحقًا).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// سجل كل إجراء مهم: مين سوّى وش، ومتى، وعلى أي شي.
/// إضافة فقط: الترحيل يضيف قاعدة في قاعدة البيانات تمنع UPDATE وDELETE.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}
