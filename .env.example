# ─────────────────────────────────────────────────────────────────────────────
# أسماء كل المتغيرات اللي يحتاجها المشروع، مع شرح كل واحد. بدون أي قيمة سرية.
#
# للتطوير على جهازك:
#   cp .env.example apps/api/.env
# ثم عبّ SESSION_SECRET وOTP_PEPPER بقيم عشوائية (الأمر تحت).
#
# للتشغيل الحقيقي: القيم تنحط في «الإعدادات السرية» عند مزوّد الاستضافة، وما تنحط في ملف.
# ملفات .env ممنوعة من المستودع (.gitignore)، والمسموح هذا الملف بس.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ الخادم (apps/api) ═══

# development للتطوير، وproduction للتشغيل الحقيقي.
NODE_ENV=development

# العنوان والمنفذ اللي يسمع عليه الخادم. 0.0.0.0 يسمح للجوال على نفس الشبكة يوصل له.
HOST=0.0.0.0
PORT=3000

# مستوى تفاصيل السجل التقني: error أو warn أو info أو debug.
LOG_LEVEL=info

# عنوان قاعدة البيانات PostgreSQL. القيمة تحت لقاعدة Docker على جهازك (pnpm db:up).
# في التشغيل الحقيقي: يعطيك إياه مزوّد الاستضافة، وفيه كلمة مرور، فيكون في الإعدادات السرية.
DATABASE_URL=postgresql://mazood:mazood@localhost:5432/mazood

# [سري] يوقّع مفاتيح الدخول. ٣٢ حرف عشوائي على الأقل، ويختلف عن OTP_PEPPER.
# تغييره يطلّع كل المستخدمين ويطلب منهم يدخلون من جديد.
# لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# [سري] يدخل في بصمة رموز التحقق وعناوين IP. ٣٢ حرف عشوائي على الأقل.
# تغييره يلغي رموز التحقق اللي انرسلت وما انستخدمت (المستخدم يطلب رمز جديد بس).
OTP_PEPPER=

# المواقع المسموح لها تتصل بالخادم من المتصفح، مفصولة بفاصلة.
# للتطوير: موقع Expo على جهازك. للتشغيل الحقيقي: نطاق الموقع (مثل https://app.mazood.sa).
CORS_ORIGINS=http://localhost:8081

# مزوّد الرسائل النصية لرموز التحقق.
#   console = يكتب الرمز في سجل الخادم بدل ما يرسله. للتطوير بس، والخادم يرفضه في production.
# المزوّد الحقيقي (سؤال 5 في PLAN.md) يُضاف هنا مع مفتاحه السري لما يتختار.
SMS_PROVIDER=console

# true إذا الخادم ورا موزّع أحمال أو بروكسي (أغلب الاستضافات)، عشان نعرف عنوان IP الحقيقي
# للمستخدم ونطبّق حدود المحاولات صح. على جهازك: false.
TRUST_PROXY=false

# ═══ الاختبارات ═══

# قاعدة الاختبار. pnpm test يمسحها كاملة ويعيد بناءها، ولازم اسمها ينتهي بـ _test.
# إذا ما حددتها، تُستخدم القيمة تحت (قاعدة Docker).
# TEST_DATABASE_URL=postgresql://mazood:mazood@localhost:5432/mazood_test

# ═══ التطبيق (apps/app) ═══
# هذي تنحط في apps/app/.env (مو apps/api/.env). Expo يضمّنها داخل التطبيق،
# فممنوع يكون فيها أي سر: أي متغير يبدأ بـ EXPO_PUBLIC_ يقدر أي أحد يشوفه.

# عنوان الخادم. إذا تركته فاضي في التطوير، التطبيق يستخدم جهاز المبرمج نفسه على المنفذ 3000.
# EXPO_PUBLIC_API_URL=https://api.mazood.sa
