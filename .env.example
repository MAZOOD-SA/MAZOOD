# ═══════════════════════════════════════════════════════════════════════
# متغيرات الإعداد اللي يحتاجها مزوّد. **أسماء بس، بدون قيم سرية.**
#
# على جهاز المبرمج: انسخ الجزء الخاص بالخادم إلى apps/api/.env وعبّه.
# على الاستضافة: تنحط في إعدادات الاستضافة (Environment variables)، مو في ملف.
# ملفات .env ما تدخل المستودع أبدًا (.gitignore يمنعها).
# ═══════════════════════════════════════════════════════════════════════

# ─── الخادم (apps/api) ───────────────────────────────────────────────

# البيئة: development (جهاز المبرمج)، staging (العنوان التجريبي)، production (المنصة الحقيقية).
# في production الخادم يرفض يشتغل لو SMS_PROVIDER=console أو DEMO_MODE أو OTP_EXPOSE_IN_RESPONSE مفعّلة.
APP_ENV=development

# عنوان قاعدة البيانات (PostgreSQL). **سري**: فيه كلمة مرور قاعدة البيانات.
# على جهاز المبرمج (docker compose up -d db): postgresql://mazood:mazood_dev@localhost:5432/mazood_dev
DATABASE_URL=

# مفتاح سري لبصمة رموز التحقق. **سري**. ٣٢ حرف عشوائي على الأقل، ويختلف لكل بيئة.
# طريقة توليده: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=

# مزوّد الرسائل النصية. الحين فيه «console» بس: الرمز يطلع في سجل الخادم.
# لما نختار مزوّد سعودي (سؤال ٥ في PLAN.md) نضيف اسمه هنا ومفتاحه تحت.
SMS_PROVIDER=console

# يرجّع رمز التحقق في رد الخادم ويظهر على الشاشة، عشان نجرّب بدون رسائل. ممنوع في production.
OTP_EXPOSE_IN_RESPONSE=false

# مزوّدين وعروض وهمية توصل تلقائيًا، عشان نجرّب الدورة كاملة. ممنوع في production.
DEMO_MODE=false

# المنفذ اللي يسمع عليه الخادم. أغلب الاستضافات تحدده بنفسها.
PORT=3000

# true إذا الخادم ورا موازن أحمال (أغلب الاستضافات)، عشان حدود المحاولات تعرف عنوان IP الحقيقي.
TRUST_PROXY=false

# المواقع المسموح لها تكلّم الخادم من المتصفح، مفصولة بفواصل. فاضي = نفس العنوان بس (الوضع الطبيعي).
# على جهاز المبرمج مع pnpm web: http://localhost:8081
CORS_ORIGINS=

# مجلد نسخة الموقع المبنية. إذا موجود، الخادم يقدّم الموقع من نفس العنوان. (في Docker محدد تلقائيًا.)
WEB_DIST_DIR=

# ─── الاختبارات ─────────────────────────────────────────────────────

# قاعدة بيانات الاختبارات. **تنمسح كاملة مع كل تشغيل للاختبارات**، فلا تحط عنوان قاعدة حقيقية.
# الافتراضي: postgresql://mazood:mazood_dev@localhost:5432/mazood_test
TEST_DATABASE_URL=

# ─── التطبيق (apps/app) ─────────────────────────────────────────────
# أي متغير يبدأ بـ EXPO_PUBLIC_ يدخل في كود التطبيق ويقدر أي أحد يقراه. **ممنوع** تحط فيه سر.

# عنوان الخادم. في الموقع المنشور ما يحتاج (نفس العنوان). للجوال وللتطوير:
# على جهاز المبرمج: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=
