# ملف الأسماء الرئيسي. كل جزء له ملفه: apps/api/.env.example (الخادم)، و apps/app/.env.example (التطبيق).
# هذي نسخة مجمّعة منهم للمرجع السريع.

## الخادم

# development أو production. في production الخادم يرفض يشتغل إذا نقص شي مهم أدناه.
NODE_ENV=

# المنفذ (الافتراضي 3001).
PORT=

# رابط قاعدة PostgreSQL (postgres://مستخدم:كلمة_المرور@المضيف:5432/الاسم). مطلوب في الإنتاج.
# إذا تركته فاضي في التطوير: يشتغل الخادم على قاعدة تجريبية داخل الذاكرة وتنمسح مع كل تشغيل.
DATABASE_URL=

# سر طويل عشوائي (٣٢ حرف أو أكثر) تُحسب فيه بصمات رموز التحقق. مطلوب في الإنتاج.
# لو تغيّر: الرموز اللي أُرسلت قبل التغيير تبطل (ما تأثر على الجلسات).
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# عناوين الواجهة المسموح لها تكلّم الخادم، مفصولة بفاصلة (مثل https://app.example.sa). مطلوب في الإنتاج.
CORS_ORIGINS=

# true إذا الخادم خلف وسيط/موزّع حمل (عشان نقرأ IP الزائر الحقيقي لتحديد المحاولات). غير ذلك: false.
TRUST_PROXY=

# مزوّد الرسائل: console (يطبع الرمز في الطرفية، للتطوير فقط، ممنوع في الإنتاج) أو none.
# بعد ما يُختار مزوّد الرسائل السعودي (سؤال ٥ في PLAN.md) يُضاف اسمه هنا مع مفاتيحه.
SMS_PROVIDER=

## التطبيق
# عنوان الخادم. إذا تركته فاضي: التطبيق يشتغل بالوضع التجريبي (بيانات وهمية، بدون خادم).
# تنبيه: أي متغير يبدأ بـ EXPO_PUBLIC_ يوصل لكل من يفتح التطبيق. ممنوع تحط فيه أي سر.
EXPO_PUBLIC_API_URL=
